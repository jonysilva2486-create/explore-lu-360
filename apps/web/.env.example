# Explore Luxembourg 360 — web environment template
# Never commit real credentials. Keep actual values in the local/runtime secret store.

# Browser-facing Google Maps Platform key.
# This key must be application-restricted (websites) and API-restricted
# to only the Google Maps APIs actually used by the application.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Canonical web origin used by the application/runtime configuration.
NEXT_PUBLIC_APP_URL=http://localhost:3000
